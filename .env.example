# =====================================================================
# AnvilCraft Panel — Local environment variables
# =====================================================================
#
# IMPORTANTE:
# - Este archivo SÍ va al repo (es una plantilla pública).
# - Copialo a `.env` y rellena los valores reales.
# - El archivo `.env` está en `.gitignore` y NO debe commitearse.
# - NUNCA commitees secretos al repositorio.
#
# Cómo usar:
#   cp .env.example .env
#   # Editar .env con tus valores reales
# =====================================================================

# ── CurseForge API ──────────────────────────────────────────────────
# Requerido para importar modpacks de CurseForge.
# Obtén tu key gratuita en: https://console.curseforge.com/
# (Login con tu cuenta → "API Keys" → "Create Key")
CURSEFORGE_API_KEY=

# ── MSIX Build (opcional) ──────────────────────────────────────────
# Solo se usa en scripts/build-msix.ps1 para empaquetar para Microsoft Store.
# Si no vas a publicar en la Store, puedes dejar esto vacío.
MSIX_CERT_PASSWORD=

# ── Tauri Updater (opcional) ───────────────────────────────────────
# Si quieres overridear la clave pública del updater (normalmente está en
# src-tauri/tauri.conf.json), puedes definirla aquí.
# TAURI_SIGNING_PUBLIC_KEY=
